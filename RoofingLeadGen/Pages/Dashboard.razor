@page "/"
@inject PropertyService PropertyService

<div class="dashboard">
    @if (_loading)
    {
        <div class="loading-spinner">
            <i class="fas fa-spinner fa-spin"></i>
            <span>Loading dashboard data...</span>
        </div>
    }
    else if (_stats != null)
    {
        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <div class="stat-icon"><i class="fas fa-building"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.TotalProperties</span>
                    <span class="stat-label">Total Properties</span>
                </div>
            </div>
            <div class="stat-card stat-success">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.TotalOwners</span>
                    <span class="stat-label">Property Owners</span>
                </div>
            </div>
            <div class="stat-card stat-warning">
                <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.TotalPermits</span>
                    <span class="stat-label">Total Permits</span>
                </div>
            </div>
            <div class="stat-card stat-danger">
                <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.RoofsOver15Years</span>
                    <span class="stat-label">Roofs 15+ Years Old</span>
                </div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <div class="stat-icon"><i class="fas fa-water"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.PropertiesInFloodZone</span>
                    <span class="stat-label">In Flood Zone</span>
                </div>
            </div>
            <div class="stat-card stat-danger">
                <div class="stat-icon"><i class="fas fa-house-damage"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.PropertiesHighRiskFlood</span>
                    <span class="stat-label">High-Risk Flood</span>
                </div>
            </div>
            <div class="stat-card stat-warning">
                <div class="stat-icon"><i class="fas fa-fire"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.PropertiesHighFireRisk</span>
                    <span class="stat-label">High Fire Risk</span>
                </div>
            </div>
            <div class="stat-card stat-success">
                <div class="stat-icon"><i class="fas fa-file-contract"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@_stats.TotalInsuranceClaims</span>
                    <span class="stat-label">Insurance Claims</span>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-map-marker-alt"></i> Properties by County</h3>
                </div>
                <div class="card-body">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>County</th>
                                <th>Properties</th>
                                <th>Flood Zone</th>
                                <th>Fire Risk</th>
                                <th>Old Roofs</th>
                                <th>Lead Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var county in _stats.CountyBreakdowns)
                            {
                                <tr>
                                    <td><strong>@county.County</strong></td>
                                    <td>@county.PropertyCount</td>
                                    <td>
                                        <span class="badge @(county.FloodZoneCount > 0 ? "badge-info" : "badge-secondary")">
                                            @county.FloodZoneCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(county.HighFireRiskCount > 0 ? "badge-warning" : "badge-secondary")">
                                            @county.HighFireRiskCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(county.OldRoofCount > 0 ? "badge-danger" : "badge-success")">
                                            @county.OldRoofCount
                                        </span>
                                    </td>
                                    <td>
                                        <div class="progress-bar-container">
                                            @{
                                                var riskPct = county.PropertyCount > 0
                                                    ? (int)((double)(county.OldRoofCount + county.FloodZoneCount + county.HighFireRiskCount) / (county.PropertyCount * 3) * 100)
                                                    : 0;
                                            }
                                            <div class="progress-bar" style="width: @(riskPct)%"></div>
                                            <span class="progress-text">@(riskPct)%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-clock"></i> Roof Age Distribution</h3>
                </div>
                <div class="card-body">
                    @foreach (var dist in _stats.RoofAgeDistributions)
                    {
                        var maxCount = _stats.RoofAgeDistributions.Max(d => d.Count);
                        var barWidth = maxCount > 0 ? (int)((double)dist.Count / maxCount * 100) : 0;
                        <div class="bar-chart-row">
                            <span class="bar-label">@dist.Range</span>
                            <div class="bar-track">
                                <div class="bar-fill @GetBarColorClass(dist.Range)" style="width: @(barWidth)%"></div>
                            </div>
                            <span class="bar-value">@dist.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card quick-actions-card">
            <div class="card-header">
                <h3><i class="fas fa-bolt"></i> Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a href="/search" class="action-btn">
                        <i class="fas fa-search"></i>
                        <span>Search by Address</span>
                    </a>
                    <a href="/search?mode=owner" class="action-btn">
                        <i class="fas fa-user"></i>
                        <span>Search by Owner</span>
                    </a>
                    <a href="/permits" class="action-btn">
                        <i class="fas fa-file-alt"></i>
                        <span>Recent Permits</span>
                    </a>
                    <a href="/risk" class="action-btn">
                        <i class="fas fa-chart-bar"></i>
                        <span>Risk Assessment</span>
                    </a>
                    <a href="/disasters" class="action-btn">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>FEMA Disasters</span>
                    </a>
                    <a href="/api-status" class="action-btn action-btn-coming-soon">
                        <i class="fas fa-code"></i>
                        <span>API & Coming Soon</span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardStats? _stats;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _stats = await PropertyService.GetDashboardStatsAsync();
        _loading = false;
    }

    private string GetBarColorClass(string range) => range switch
    {
        "0-5 years" => "bar-green",
        "6-10 years" => "bar-teal",
        "11-15 years" => "bar-yellow",
        "16-20 years" => "bar-orange",
        "20+ years" => "bar-red",
        _ => "bar-teal"
    };
}
