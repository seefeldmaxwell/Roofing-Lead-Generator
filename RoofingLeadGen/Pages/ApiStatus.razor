@page "/api-status"

<div class="api-status-page">
    <div class="page-header">
        <h2><i class="fas fa-code"></i> API Status & Data Sources</h2>
        <p>Live government data sources, API endpoints, and upcoming features for the Florida Property & Permit Tracker</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-database"></i> Live Government Data Sources</h3>
        </div>
        <div class="card-body">
            <div class="data-sources-list">
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>FDOT Statewide Parcels</strong>
                    <span class="text-muted">Property data for all 67 FL counties via ArcGIS FeatureServer</span>
                    <code>gis.fdot.gov/arcgis/rest/services/Parcels/FeatureServer</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>FL Statewide Cadastral</strong>
                    <span class="text-muted">FL Dept of Revenue parcel & owner data</span>
                    <code>services9.arcgis.com/.../FL_Statewide_Cadastral</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>FEMA NFHL</strong>
                    <span class="text-muted">National Flood Hazard Layer - flood zone by lat/long</span>
                    <code>hazards.fema.gov/gis/nfhl/rest/services/public/NFHL</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>OpenFEMA API</strong>
                    <span class="text-muted">Disaster declarations, NFIP flood claims by zip code</span>
                    <code>fema.gov/api/open/v2/DisasterDeclarationsSummaries</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>NIFC / IRWIN</strong>
                    <span class="text-muted">National Interagency Fire Center - active wildfire incidents</span>
                    <code>services3.arcgis.com/.../IRWIN_Incidents/FeatureServer</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>NOAA Weather API</strong>
                    <span class="text-muted">Active weather alerts, forecasts, storm events</span>
                    <code>api.weather.gov/alerts/active</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-success">Live</span>
                    <strong>US Census Geocoder</strong>
                    <span class="text-muted">Address geocoding for any Florida address</span>
                    <code>geocoding.geo.census.gov/geocoder/</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-info">Available</span>
                    <strong>NASA FIRMS</strong>
                    <span class="text-muted">VIIRS satellite fire hotspot detection (requires free MAP_KEY)</span>
                    <code>firms.modaps.eosdis.nasa.gov/api/area/csv/</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-info">Available</span>
                    <strong>Miami-Dade Permits</strong>
                    <span class="text-muted">Building permits via Miami-Dade Open Data Hub</span>
                    <code>gisweb.miamidade.gov/arcgis/rest/services</code>
                </div>
                <div class="data-source-row">
                    <span class="badge badge-info">Available</span>
                    <strong>SBA Disaster Loans</strong>
                    <span class="text-muted">Small Business Administration disaster loan data by zip</span>
                    <code>SBA CKAN API</code>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-check-circle" style="color: var(--success);"></i> Live Application Endpoints</h3>
        </div>
        <div class="card-body">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>Endpoint</th>
                        <th>Method</th>
                        <th>Data Source</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Property Search (Address)</strong></td>
                        <td><code>/api/properties/search?mode=address&q=...</code></td>
                        <td><span class="badge badge-info">GET</span></td>
                        <td><small>FDOT + Cadastral</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>Property Search (Owner)</strong></td>
                        <td><code>/api/properties/search?mode=owner&q=...</code></td>
                        <td><span class="badge badge-info">GET</span></td>
                        <td><small>FDOT + Cadastral</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>Property Details + Flood Enrichment</strong></td>
                        <td><code>/api/properties/{"{id}"}</code></td>
                        <td><span class="badge badge-info">GET</span></td>
                        <td><small>FDOT + FEMA NFHL</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>Permit History</strong></td>
                        <td><code>/api/properties/{"{id}"}/permits</code></td>
                        <td><span class="badge badge-info">GET</span></td>
                        <td><small>Miami-Dade Open Data</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>Dashboard Stats (Flood/Fire/Risk)</strong></td>
                        <td><code>/api/properties/stats</code></td>
                        <td><span class="badge badge-info">GET</span></td>
                        <td><small>Aggregated Local DB</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>FEMA Disaster Declarations</strong></td>
                        <td><code>/disasters</code></td>
                        <td><span class="badge badge-info">PAGE</span></td>
                        <td><small>OpenFEMA API</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                    <tr>
                        <td><strong>Risk Assessment Dashboard</strong></td>
                        <td><code>/risk</code></td>
                        <td><span class="badge badge-info">PAGE</span></td>
                        <td><small>FEMA + NIFC + NOAA</small></td>
                        <td><span class="badge badge-success">Live</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card coming-soon-card">
        <div class="card-header">
            <h3><i class="fas fa-rocket" style="color: var(--accent-teal);"></i> Coming Soon</h3>
        </div>
        <div class="card-body">
            <div class="coming-soon-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-bell"></i></div>
                    <h4>Real-Time Permit Webhooks</h4>
                    <p>Subscribe to real-time notifications when new roofing permits are filed in your target areas.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q3 2026</span>
                        <code>POST /api/v2/webhooks/permits</code>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-file-csv"></i></div>
                    <h4>Batch Property Lookup</h4>
                    <p>Upload a CSV of addresses to get bulk property and permit data in one request.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q3 2026</span>
                        <code>POST /api/v2/properties/batch</code>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-brain"></i></div>
                    <h4>AI Lead Scoring</h4>
                    <p>Intelligent lead scores based on roof age, flood zone, fire risk, storm history, and claim patterns.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q4 2026</span>
                        <code>GET /api/v2/leads/score</code>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-cloud-showers-heavy"></i></div>
                    <h4>Storm Damage Assessment</h4>
                    <p>Cross-reference NOAA storm events with property locations to identify potential roof damage leads.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q4 2026</span>
                        <code>GET /api/v2/weather/storm-history</code>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-mail-bulk"></i></div>
                    <h4>Automated Outreach Campaigns</h4>
                    <p>Create targeted campaigns for homeowners with aging roofs in flood zones or post-disaster areas.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q1 2027</span>
                        <code>POST /api/v2/campaigns</code>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-satellite"></i></div>
                    <h4>Satellite Roof Analysis</h4>
                    <p>AI-powered analysis of satellite imagery to assess roof condition, material type, and estimated remaining lifespan.</p>
                    <div class="feature-meta">
                        <span class="badge badge-coming-soon">Q1 2027</span>
                        <code>GET /api/v2/properties/{"{id}"}/aerial</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
