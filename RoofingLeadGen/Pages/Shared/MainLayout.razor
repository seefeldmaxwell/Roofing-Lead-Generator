@inherits LayoutComponentBase

<div class="app-container">
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="fas fa-home"></i>
                <span>FL Property<br/><small>Permit Tracker</small></span>
            </div>
        </div>
        <ul class="nav-menu">
            <li>
                <NavLink href="/dashboard" Match="NavLinkMatch.All">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/search">
                    <i class="fas fa-search"></i>
                    <span>Property Search</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/permits">
                    <i class="fas fa-file-alt"></i>
                    <span>Recent Permits</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/risk">
                    <i class="fas fa-chart-bar"></i>
                    <span>Risk Assessment</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/disasters">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>FEMA Disasters</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/api-status">
                    <i class="fas fa-code"></i>
                    <span>API & Data Sources</span>
                </NavLink>
            </li>
        </ul>
        <div class="sidebar-footer">
            <a href="/account/logout" class="sidebar-logout-btn"><i class="fas fa-sign-out-alt"></i> <span>Sign Out</span></a>
            <div class="env-badge">FLORIDA DATA</div>
        </div>
    </nav>

    <main class="main-content">
        <header class="top-header">
            <div class="header-gradient">
                <h1 class="header-title">Florida Property & Permit Tracker</h1>
                <p class="header-subtitle">Real-time property data, flood zones, fire risk, permits & lead generation for roofers and public adjusters</p>
            </div>
        </header>
        <div class="content-area">
            @Body
        </div>
    </main>
</div>
