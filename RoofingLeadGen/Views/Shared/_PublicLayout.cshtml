@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["PageTitle"] - Florida Property & Permit Tracker</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta name="keywords" content="@ViewData["MetaKeywords"]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    <meta property="og:title" content="@ViewData["PageTitle"] - Florida Property & Permit Tracker" />
    <meta property="og:description" content="@ViewData["MetaDescription"]" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["PageTitle"]" />
    <meta name="twitter:description" content="@ViewData["MetaDescription"]" />
    <base href="~/" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    @RenderSection("HeadExtra", required: false)
</head>
<body>
    <nav class="public-nav">
        <div class="public-nav-inner">
            <a href="/" class="public-logo">
                <i class="fas fa-home"></i>
                <span>FL Property Tracker</span>
            </a>
            <div class="public-nav-links">
                <a href="/counties">All Counties</a>
                <a href="/account/login" class="nav-btn-outline">Sign In</a>
                <a href="/account/register" class="nav-btn-primary">Get Started Free</a>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="public-footer">
        <div class="footer-inner">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4><i class="fas fa-home"></i> FL Property Tracker</h4>
                    <p>Real-time Florida property data, permit tracking, flood zone analysis, and wildfire risk scoring from official government sources.</p>
                </div>
                <div class="footer-col">
                    <h4>Top Counties</h4>
                    <ul>
                        <li><a href="/florida/miami-dade">Miami-Dade County</a></li>
                        <li><a href="/florida/broward">Broward County</a></li>
                        <li><a href="/florida/palm-beach">Palm Beach County</a></li>
                        <li><a href="/florida/hillsborough">Hillsborough County</a></li>
                        <li><a href="/florida/orange">Orange County</a></li>
                        <li><a href="/florida/duval">Duval County</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Top Cities</h4>
                    <ul>
                        <li><a href="/florida/miami-dade/miami">Miami</a></li>
                        <li><a href="/florida/broward/fort-lauderdale">Fort Lauderdale</a></li>
                        <li><a href="/florida/hillsborough/tampa">Tampa</a></li>
                        <li><a href="/florida/orange/orlando">Orlando</a></li>
                        <li><a href="/florida/duval/jacksonville">Jacksonville</a></li>
                        <li><a href="/florida/pinellas/st-petersburg">St. Petersburg</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Data Sources</h4>
                    <ul>
                        <li>FEMA Flood Hazard Layer</li>
                        <li>OpenFEMA Disaster API</li>
                        <li>FDOT Statewide Parcels</li>
                        <li>FL Dept. of Revenue</li>
                        <li>NIFC Wildfire Data</li>
                        <li>NOAA Weather API</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>Data sourced from official U.S. government APIs. All data is publicly available. Not affiliated with any government agency.</p>
            </div>
        </div>
    </footer>
</body>
</html>
