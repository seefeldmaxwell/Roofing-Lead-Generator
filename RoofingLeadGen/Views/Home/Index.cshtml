@{
    ViewData["PageTitle"] = "Florida Property Data, Permits & Risk Analysis for Roofers";
    ViewData["MetaDescription"] = "Access real-time Florida property records, building permits, FEMA flood zones, and wildfire risk data across all 67 counties. Free tools for roofing contractors and public adjusters.";
    ViewData["MetaKeywords"] = "Florida property data, roofing permits, flood zone lookup, wildfire risk, FEMA disasters, roofing leads, public adjuster tools, FL property records";
    ViewData["CanonicalUrl"] = "/";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section HeadExtra {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebApplication",
        "name": "FL Property & Permit Tracker",
        "description": "Real-time Florida property data, building permits, FEMA flood zones, and wildfire risk analysis for roofing contractors and public adjusters.",
        "url": "/",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "areaServed": {
            "@@type": "State",
            "name": "Florida",
            "containedInPlace": {
                "@@type": "Country",
                "name": "United States"
            }
        }
    }
    </script>
}

<section class="hero-section">
    <div class="hero-inner">
        <div class="hero-content">
            <h1>Florida Property Intelligence<br/><span class="hero-accent">for Roofing Professionals</span></h1>
            <p class="hero-description">
                Access real-time property records, building permits, FEMA flood zones, and wildfire risk data
                across all 67 Florida counties. Powered by official government APIs.
            </p>
            <div class="hero-actions">
                <a href="/account/login" class="hero-btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Sign In Free
                </a>
                <a href="/counties" class="hero-btn-secondary">
                    <i class="fas fa-map-marked-alt"></i> Browse by County
                </a>
            </div>
            <div class="hero-trust">
                <span><i class="fas fa-shield-alt"></i> 100% Government Data</span>
                <span><i class="fas fa-lock-open"></i> Free Public Access</span>
                <span><i class="fas fa-sync-alt"></i> Real-Time Updates</span>
            </div>
        </div>
        <div class="hero-stats-panel">
            <div class="hero-stat">
                <span class="hero-stat-number">67</span>
                <span class="hero-stat-label">Florida Counties</span>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-number">@(((int)ViewData["TotalDisasters"]) > 0 ? ViewData["TotalDisasters"] : "100+")</span>
                <span class="hero-stat-label">FEMA Disasters Tracked</span>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-number">6</span>
                <span class="hero-stat-label">Government APIs</span>
            </div>
            <div class="hero-stat">
                <span class="hero-stat-number">Live</span>
                <span class="hero-stat-label">Data Feeds</span>
            </div>
        </div>
    </div>
</section>

<section class="features-section" id="features">
    <div class="section-inner">
        <h2 class="section-title">Everything You Need to Find Roofing Leads</h2>
        <p class="section-subtitle">Real government data, zero guesswork</p>

        <div class="features-grid">
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-search"></i></div>
                <h3>Property Search</h3>
                <p>Search any Florida property by address, owner name, or parcel ID. Get instant results from FDOT statewide parcel data covering all 67 counties.</p>
            </div>
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-file-alt"></i></div>
                <h3>Permit Tracking</h3>
                <p>Monitor building permits in real-time. Automatically classifies roofing, electrical, HVAC, plumbing, and 15+ work categories from public records.</p>
            </div>
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-water"></i></div>
                <h3>FEMA Flood Zones</h3>
                <p>Instant flood zone lookup using FEMA's National Flood Hazard Layer. Identifies high-risk zones, insurance requirements, and DFIRM map panels.</p>
            </div>
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-fire"></i></div>
                <h3>Wildfire Risk Analysis</h3>
                <p>County-level wildfire risk scoring from NIFC active incident data. Tracks fire proximity, acres burned, and structures impacted.</p>
            </div>
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <h3>FEMA Disaster Tracking</h3>
                <p>Live feed of FEMA disaster declarations for Florida. Track Individual Assistance, Public Assistance, and Hazard Mitigation programs by county.</p>
            </div>
            <div class="feature-block">
                <div class="feature-block-icon"><i class="fas fa-chart-line"></i></div>
                <h3>Lead Scoring & Prioritization</h3>
                <p>Automatically identifies properties with old roofs, flood zone exposure, fire damage risk, and open insurance claims to prioritize your outreach.</p>
            </div>
        </div>
    </div>
</section>

<section class="data-sources-section">
    <div class="section-inner">
        <h2 class="section-title">Powered by Real Government Data</h2>
        <p class="section-subtitle">No scraped data. No estimates. Direct feeds from official APIs.</p>

        <div class="sources-grid">
            <div class="source-card">
                <div class="source-badge">FEMA</div>
                <h4>National Flood Hazard Layer</h4>
                <p>Flood zone determination for any coordinate in Florida</p>
            </div>
            <div class="source-card">
                <div class="source-badge">FEMA</div>
                <h4>OpenFEMA Disaster API</h4>
                <p>Disaster declarations, NFIP claims, and policy data</p>
            </div>
            <div class="source-card">
                <div class="source-badge">FDOT</div>
                <h4>Statewide Parcels</h4>
                <p>Property records from all 67 Florida counties</p>
            </div>
            <div class="source-card">
                <div class="source-badge">FL DOR</div>
                <h4>Statewide Cadastral</h4>
                <p>Florida Dept. of Revenue parcel and assessment data</p>
            </div>
            <div class="source-card">
                <div class="source-badge">NIFC</div>
                <h4>IRWIN Fire Incidents</h4>
                <p>Active wildfire tracking and historical incident data</p>
            </div>
            <div class="source-card">
                <div class="source-badge">NOAA</div>
                <h4>Weather & Storm Data</h4>
                <p>Active alerts, forecasts, and historical storm events</p>
            </div>
        </div>
    </div>
</section>

<section class="counties-preview-section">
    <div class="section-inner">
        <h2 class="section-title">Browse by Florida County</h2>
        <p class="section-subtitle">Location-specific property data for all 67 counties</p>

        <div class="county-chips">
            @foreach (var county in RoofingLeadGen.Services.LandingPageService.FloridaCounties.OrderBy(c => c.Value))
            {
                <a href="/florida/@county.Key" class="county-chip">@county.Value</a>
            }
        </div>

        <div style="text-align: center; margin-top: 2rem;">
            <a href="/counties" class="hero-btn-secondary"><i class="fas fa-map"></i> View All Counties & Cities</a>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="section-inner">
        <div class="cta-content">
            <h2>Start Finding Roofing Leads Today</h2>
            <p>Free access to Florida property data, permits, and risk analysis. No credit card required.</p>
            <a href="/account/login" class="hero-btn-primary">
                <i class="fas fa-sign-in-alt"></i> Sign In Free
            </a>
        </div>
    </div>
</section>
