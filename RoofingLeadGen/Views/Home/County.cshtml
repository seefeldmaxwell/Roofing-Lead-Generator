@using RoofingLeadGen.Services
@{
    var countyName = (string)ViewData["CountyName"]!;
    var countySlug = (string)ViewData["CountySlug"]!;
    var stats = (CountyStats)ViewData["Stats"]!;

    ViewData["PageTitle"] = $"Roofing Leads & Property Data in {countyName} County, FL";
    ViewData["MetaDescription"] = $"Access real-time property records, building permits, FEMA flood zones, and wildfire risk data for {countyName} County, Florida. Find roofing leads and track permits from official government sources.";
    ViewData["MetaKeywords"] = $"{countyName} County property data, {countyName} roofing permits, {countyName} flood zone, {countyName} wildfire risk, {countyName} County FL roofing leads, {countyName} building permits";
    ViewData["CanonicalUrl"] = $"/florida/{countySlug}";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

@section HeadExtra {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebPage",
        "name": "Roofing Leads & Property Data in @countyName County, FL",
        "description": "@ViewData["MetaDescription"]",
        "url": "/florida/@countySlug",
        "isPartOf": {
            "@@type": "WebSite",
            "name": "FL Property & Permit Tracker",
            "url": "/"
        },
        "about": {
            "@@type": "AdministrativeArea",
            "name": "@countyName County",
            "containedInPlace": {
                "@@type": "State",
                "name": "Florida"
            }
        },
        "breadcrumb": {
            "@@type": "BreadcrumbList",
            "itemListElement": [
                { "@@type": "ListItem", "position": 1, "name": "Home", "item": "/" },
                { "@@type": "ListItem", "position": 2, "name": "Florida Counties", "item": "/counties" },
                { "@@type": "ListItem", "position": 3, "name": "@countyName County" }
            ]
        }
    }
    </script>
}

<section class="location-hero">
    <div class="section-inner">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/">Home</a> <i class="fas fa-chevron-right"></i>
            <a href="/counties">Florida Counties</a> <i class="fas fa-chevron-right"></i>
            <span>@countyName County</span>
        </nav>

        <h1>Roofing Leads & Property Data in<br/><span class="hero-accent">@countyName County, Florida</span></h1>
        <p class="hero-description">
            Access real-time property records, building permits, FEMA flood zone data, and wildfire risk analysis
            for @countyName County. All data sourced from official government APIs.
        </p>

        <div class="hero-actions">
            <a href="/account/register" class="hero-btn-primary">
                <i class="fas fa-rocket"></i> Search @countyName County Properties
            </a>
            <a href="/account/login" class="hero-btn-secondary">
                <i class="fas fa-sign-in-alt"></i> Sign In
            </a>
        </div>
    </div>
</section>

<section class="location-stats-section">
    <div class="section-inner">
        <h2 class="section-title">@countyName County at a Glance</h2>
        <div class="location-stats-grid">
            <div class="location-stat-card">
                <i class="fas fa-home"></i>
                <span class="location-stat-num">@(stats.PropertyCount > 0 ? stats.PropertyCount.ToString("N0") : "Searching...")</span>
                <span class="location-stat-label">Properties Tracked</span>
            </div>
            <div class="location-stat-card">
                <i class="fas fa-file-alt"></i>
                <span class="location-stat-num">@(stats.PermitCount > 0 ? stats.PermitCount.ToString("N0") : "Available")</span>
                <span class="location-stat-label">Building Permits</span>
            </div>
            <div class="location-stat-card">
                <i class="fas fa-exclamation-triangle"></i>
                <span class="location-stat-num">@(stats.DisasterCount > 0 ? stats.DisasterCount.ToString() : "Check")</span>
                <span class="location-stat-label">FEMA Disasters</span>
            </div>
            <div class="location-stat-card">
                <i class="fas fa-hard-hat"></i>
                <span class="location-stat-num">@(stats.OldRoofCount > 0 ? stats.OldRoofCount.ToString("N0") : "Search")</span>
                <span class="location-stat-label">Roofs 15+ Years Old</span>
            </div>
        </div>
    </div>
</section>

<section class="location-content-section">
    <div class="section-inner">
        <div class="location-content-grid">
            <div class="location-content-main">
                <h2>Property & Permit Data for @countyName County, FL</h2>
                <p>
                    Our platform provides comprehensive property intelligence for @countyName County, Florida.
                    Using data from FDOT Statewide Parcels, the Florida Department of Revenue Cadastral database,
                    and FEMA's National Flood Hazard Layer, we deliver real-time insights that help roofing contractors
                    and public adjusters identify opportunities.
                </p>

                <h3>What You Can Find for @countyName County</h3>
                <ul class="feature-list">
                    <li><i class="fas fa-check"></i> Property records with owner information, year built, and assessed values</li>
                    <li><i class="fas fa-check"></i> Building permit history with automatic roofing permit detection</li>
                    <li><i class="fas fa-check"></i> FEMA flood zone determination for every property</li>
                    <li><i class="fas fa-check"></i> Wildfire risk scoring based on NIFC incident data</li>
                    <li><i class="fas fa-check"></i> FEMA disaster declarations affecting @countyName County</li>
                    <li><i class="fas fa-check"></i> Roof age calculations from permit records</li>
                    <li><i class="fas fa-check"></i> Insurance claim tracking and risk assessment</li>
                </ul>

                <h3>Why @countyName County?</h3>
                <p>
                    @countyName County is one of Florida's key markets for roofing professionals. With Florida's
                    exposure to hurricanes, tropical storms, and heavy rainfall, property owners in @countyName County
                    face ongoing roof maintenance and replacement needs. Our data helps you identify properties with
                    aging roofs, flood zone exposure, and recent disaster impacts.
                </p>
            </div>

            <aside class="location-sidebar">
                <div class="sidebar-card">
                    <h4><i class="fas fa-database"></i> Data Sources for @countyName County</h4>
                    <ul class="data-list">
                        <li><strong>Property Records:</strong> FDOT Statewide Parcels</li>
                        <li><strong>Flood Zones:</strong> FEMA NFHL</li>
                        <li><strong>Disasters:</strong> OpenFEMA API</li>
                        <li><strong>Fire Risk:</strong> NIFC / IRWIN</li>
                        <li><strong>Weather:</strong> NOAA</li>
                    </ul>
                </div>

                @{
                    var countyCities = LandingPageService.FloridaCities
                        .Where(c => c.Value.County.Equals(countyName, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                }

                @if (countyCities.Any())
                {
                    <div class="sidebar-card">
                        <h4><i class="fas fa-city"></i> Cities in @countyName County</h4>
                        <ul class="city-list">
                            @foreach (var city in countyCities)
                            {
                                <li><a href="/florida/@countySlug/@city.Key">@city.Value.City</a></li>
                            }
                        </ul>
                    </div>
                }

                <div class="sidebar-card sidebar-cta">
                    <h4>Ready to Find Leads?</h4>
                    <p>Search @countyName County properties with real government data.</p>
                    <a href="/account/register" class="hero-btn-primary" style="width:100%;text-align:center;">Get Started Free</a>
                </div>
            </aside>
        </div>
    </div>
</section>
