<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Pages.Shared.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Pages.Shared.MainLayout)">
            <div class="not-found-container">
                <i class="fas fa-search" style="font-size: 3rem; color: var(--accent-teal); margin-bottom: 1rem;"></i>
                <h2>Page Not Found</h2>
                <p>The page you're looking for doesn't exist.</p>
                <a href="/dashboard" class="btn-primary">Back to Dashboard</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
